<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UYMerge.App.ViewModels"
        xmlns:models="using:UYMerge.App.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="UYMerge.App.Views.MainView"
        x:DataType="vm:MainViewModel"
        Title="UnityYAML Merger"
        Width="1280"
        Height="820"
        MinWidth="900"
        MinHeight="600"
        Background="#18191C"
        Foreground="#E5E7EB"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#E5E7EB" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="Background" Value="#222429" />
      <Setter Property="Foreground" Value="#E5E7EB" />
      <Setter Property="BorderBrush" Value="#393C44" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style Selector="Button">
      <Setter Property="Background" Value="#30333A" />
      <Setter Property="Foreground" Value="#F3F4F6" />
      <Setter Property="BorderBrush" Value="#454954" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12,7" />
    </Style>

    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#414550" />
    </Style>

    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#202126" />
      <Setter Property="BorderBrush" Value="#363941" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style Selector="Border.section-header">
      <Setter Property="Background" Value="#292B31" />
      <Setter Property="Padding" Value="10,7" />
    </Style>

    <Style Selector="TreeView">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="2" />
    </Style>

    <Style Selector="TreeViewItem">
      <Setter Property="Padding" Value="1,2" />
      <Setter Property="Foreground" Value="#E5E7EB" />
    </Style>

    <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="#30333A" />
    </Style>

    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="#3A3D46" />
    </Style>

    <Style Selector="GridSplitter">
      <Setter Property="Background" Value="#393C44" />
      <Setter Property="Height" Value="5" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="ResizeDirection" Value="Rows" />
      <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto"
        Margin="12"
        RowSpacing="10">

    <!-- Toolbar -->
    <Border Grid.Row="0"
            Classes="panel"
            Padding="12">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="14">

        <StackPanel Grid.Column="0"
                    Spacing="3"
                    VerticalAlignment="Center">
          <TextBlock Text="UnityYAML Merger"
                     FontSize="20"
                     FontWeight="Bold" />
          <TextBlock Text="Three-way merge"
                     FontSize="11"
                     Foreground="#9CA3AF" />
        </StackPanel>

        <Grid Grid.Column="1"
              RowDefinitions="Auto,Auto,Auto,Auto"
              ColumnDefinitions="Auto,*,Auto"
              RowSpacing="5"
              ColumnSpacing="8">

          <TextBlock Grid.Row="0"
                     Grid.Column="0"
                     Text="BASE"
                     FontSize="11"
                     FontWeight="Bold"
                     VerticalAlignment="Center"
                     Foreground="#A5A9B4" />
          <TextBox Grid.Row="0"
                   Grid.Column="1"
                   Text="{Binding BasePath}"
                   Watermark="Base YAML file"
                   IsReadOnly="True" />
          <Button Grid.Row="0"
                  Grid.Column="2"
                  Content="参照..."
                  Command="{Binding SelectBaseCommand}" />

          <TextBlock Grid.Row="1"
                     Grid.Column="0"
                     Text="OURS"
                     FontSize="11"
                     FontWeight="Bold"
                     VerticalAlignment="Center"
                     Foreground="#A5A9B4" />
          <TextBox Grid.Row="1"
                   Grid.Column="1"
                   Text="{Binding OursPath}"
                   Watermark="Ours YAML file"
                   IsReadOnly="True" />
          <Button Grid.Row="1"
                  Grid.Column="2"
                  Content="参照..."
                  Command="{Binding SelectOursCommand}" />

          <TextBlock Grid.Row="2"
                     Grid.Column="0"
                     Text="THEIRS"
                     FontSize="11"
                     FontWeight="Bold"
                     VerticalAlignment="Center"
                     Foreground="#A5A9B4" />
          <TextBox Grid.Row="2"
                   Grid.Column="1"
                   Text="{Binding TheirsPath}"
                   Watermark="Theirs YAML file"
                   IsReadOnly="True" />
          <Button Grid.Row="2"
                  Grid.Column="2"
                  Content="参照..."
                  Command="{Binding SelectTheirsCommand}" />

          <TextBlock Grid.Row="3"
                     Grid.Column="0"
                     Text="OUTPUT"
                     FontSize="11"
                     FontWeight="Bold"
                     VerticalAlignment="Center"
                     Foreground="#A5A9B4" />
          <TextBox Grid.Row="3"
                   Grid.Column="1"
                   Text="{Binding OutputPath}"
                   Watermark="Output YAML file"
                   IsReadOnly="True" />
          <Button Grid.Row="3"
                  Grid.Column="2"
                  Content="参照..."
                  Command="{Binding SelectOutputCommand}" />
        </Grid>

        <StackPanel Grid.Column="2"
                    Spacing="8"
                    VerticalAlignment="Center">
          <Button Content="マージ実行"
                  Command="{Binding MergeCommand}"
                  HorizontalAlignment="Stretch" />
          <Button Content="保存"
                  Command="{Binding SaveCommand}"
                  IsEnabled="{Binding CanSave}"
                  HorizontalAlignment="Stretch" />
        </StackPanel>

        <Border Grid.Column="3"
                Background="#292B31"
                CornerRadius="4"
                Padding="10"
                VerticalAlignment="Center">
          <StackPanel Spacing="4">
            <TextBlock Text="CONFLICTS"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="#A5A9B4" />
            <TextBlock Text="{Binding ConflictCount}"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#C4A7FF" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Change legend -->
    <Border Grid.Row="1"
            Classes="panel"
            Padding="10,7">
      <StackPanel Orientation="Horizontal"
                  Spacing="18">
        <TextBlock Text="CHANGE LEGEND"
                   FontSize="10"
                   FontWeight="Bold"
                   Foreground="#9CA3AF"
                   VerticalAlignment="Center" />

        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock Text="+"
                     FontWeight="Bold"
                     Foreground="#6DD6A0" />
          <TextBlock Text="Added" FontSize="12" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock Text="-"
                     FontWeight="Bold"
                     Foreground="#FF7777" />
          <TextBlock Text="Deleted" FontSize="12" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock Text="*"
                     FontWeight="Bold"
                     Foreground="#FFBD69" />
          <TextBlock Text="Modified" FontSize="12" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock Text="!"
                     FontWeight="Bold"
                     Foreground="#C4A7FF" />
          <TextBlock Text="Conflict" FontSize="12" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Three-way comparison -->
    <Grid Grid.Row="2"
          ColumnDefinitions="*,*,*"
          ColumnSpacing="8">

      <!-- OURS -->
      <Border Grid.Column="0"
              Classes="panel"
              ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,5,*">

          <Border Grid.Row="0"
                  Classes="section-header">
            <Grid ColumnDefinitions="Auto,*">
              <Border Background="#31483D"
                      CornerRadius="3"
                      Padding="7,3"
                      Margin="0,0,8,0">
                <TextBlock Text="OURS"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#8FE3B3" />
              </Border>
              <TextBlock Grid.Column="1"
                         Text="Working copy"
                         FontSize="12"
                         Foreground="#A5A9B4"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>

          <TreeView Grid.Row="1"
                    ItemsSource="{Binding OursHierarchy}"
                    SelectedItem="{Binding SelectedOursNode, Mode=TwoWay}"
                    Margin="6">
            <TreeView.DataTemplates>
              <TreeDataTemplate DataType="models:UnityHierarchyNode"
                  ItemsSource="{Binding Children}">
                <Border Background="{Binding ChangeBackground}"
                        BorderBrush="{Binding UnderlineBrush}"
                        BorderThickness="0,0,0,2"
                        Padding="4,3"
                        CornerRadius="3">
                  <Grid ColumnDefinitions="10,16,16,*"
                        ColumnSpacing="5">
                    <!-- 子孫に変更がある場合の ▼ -->
                    <TextBlock Grid.Column="0"
                               Text="▼"
                               Foreground="{Binding DescendantIndicatorBrush}"
                               IsVisible="{Binding HasDescendantChange}"
                               FontSize="9"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />

                    <!-- 自身の変更マーカー -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding ChangeMarker}"
                               Foreground="{Binding ChangeBrush}"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />

                    <!-- 既存のアイコン -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding Icon}"
                               Foreground="#9CA3AF"
                               FontSize="10"
                               VerticalAlignment="Center" />

                    <!-- GameObject名 -->
                    <TextBlock Grid.Column="3"
                               Text="{Binding Name}"
                               Foreground="#E5E7EB"
                               FontSize="12"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </TreeDataTemplate>
            </TreeView.DataTemplates>
          </TreeView>

          <GridSplitter Grid.Row="2" />

          <Grid Grid.Row="3"
                RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Classes="section-header">
              <TextBlock Text="INSPECTOR"
                         FontSize="11"
                         FontWeight="Bold"
                         Foreground="#A5A9B4" />
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding SelectedOursNode.Components}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#363941"
                            BorderThickness="0,0,0,1"
                            Padding="10,8">
                      <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Change}"
                                     MinWidth="14"
                                     FontWeight="Bold" />
                          <TextBlock Text="{Binding Icon}"
                                     Foreground="#9CA3AF" />
                          <TextBlock Text="{Binding TypeName}"
                                     FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding RawText}"
                                   FontSize="10"
                                   Foreground="#9CA3AF"
                                   TextWrapping="Wrap"
                                   MaxHeight="100" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>

      <!-- BASE -->
      <Border Grid.Column="1"
              Classes="panel"
              ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,5,*">

          <Border Grid.Row="0"
                  Classes="section-header">
            <Grid ColumnDefinitions="Auto,*">
              <Border Background="#343740"
                      CornerRadius="3"
                      Padding="7,3"
                      Margin="0,0,8,0">
                <TextBlock Text="BASE"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#D1D5DB" />
              </Border>
              <TextBlock Grid.Column="1"
                         Text="Common ancestor"
                         FontSize="12"
                         Foreground="#A5A9B4"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>

          <TreeView Grid.Row="1"
                    ItemsSource="{Binding BaseHierarchy}"
                    SelectedItem="{Binding SelectedBaseNode, Mode=TwoWay}"
                    Margin="6">
            <TreeView.DataTemplates>
              <TreeDataTemplate DataType="models:UnityHierarchyNode"
                   ItemsSource="{Binding Children}">
                <Border Background="{Binding ChangeBackground}"
                        BorderBrush="{Binding UnderlineBrush}"
                        BorderThickness="0,0,0,2"
                        Padding="4,3"
                        CornerRadius="3">
                  <Grid ColumnDefinitions="10,16,16,*"
                        ColumnSpacing="5">
                    <!-- 子孫に変更がある場合の ▼ -->
                    <TextBlock Grid.Column="0"
                               Text="▼"
                               Foreground="{Binding DescendantIndicatorBrush}"
                               IsVisible="{Binding HasDescendantChange}"
                               FontSize="9"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />

                    <!-- 自身の変更マーカー -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding ChangeMarker}"
                               Foreground="{Binding ChangeBrush}"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />

                    <!-- 既存のアイコン -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding Icon}"
                               Foreground="#9CA3AF"
                               FontSize="10"
                               VerticalAlignment="Center" />

                    <!-- GameObject名 -->
                    <TextBlock Grid.Column="3"
                               Text="{Binding Name}"
                               Foreground="#E5E7EB"
                               FontSize="12"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </TreeDataTemplate>
            </TreeView.DataTemplates>
          </TreeView>

          <GridSplitter Grid.Row="2" />

          <Grid Grid.Row="3"
                RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Classes="section-header">
              <TextBlock Text="INSPECTOR"
                         FontSize="11"
                         FontWeight="Bold"
                         Foreground="#A5A9B4" />
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding SelectedBaseNode.Components}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#363941"
                            BorderThickness="0,0,0,1"
                            Padding="10,8">
                      <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Change}"
                                     MinWidth="14"
                                     FontWeight="Bold" />
                          <TextBlock Text="{Binding Icon}"
                                     Foreground="#9CA3AF" />
                          <TextBlock Text="{Binding TypeName}"
                                     FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding RawText}"
                                   FontSize="10"
                                   Foreground="#9CA3AF"
                                   TextWrapping="Wrap"
                                   MaxHeight="100" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>

      <!-- THEIRS -->
      <Border Grid.Column="2"
              Classes="panel"
              ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,5,*">

          <Border Grid.Row="0"
                  Classes="section-header">
            <Grid ColumnDefinitions="Auto,*">
              <Border Background="#343740"
                      CornerRadius="3"
                      Padding="7,3"
                      Margin="0,0,8,0">
                <TextBlock Text="THEIRS"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#D1D5DB" />
              </Border>
              <TextBlock Grid.Column="1"
                         Text="Incoming changes"
                         FontSize="12"
                         Foreground="#A5A9B4"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>

          <TreeView Grid.Row="1"
                    ItemsSource="{Binding TheirsHierarchy}"
                    SelectedItem="{Binding SelectedTheirsNode, Mode=TwoWay}"
                    Margin="6">
            <TreeView.DataTemplates>
              <TreeDataTemplate DataType="models:UnityHierarchyNode"
                  ItemsSource="{Binding Children}">
                <Border Background="{Binding ChangeBackground}"
                        BorderBrush="{Binding UnderlineBrush}"
                        BorderThickness="0,0,0,2"
                        Padding="4,3"
                        CornerRadius="3">
                  <Grid ColumnDefinitions="10,16,16,*"
                        ColumnSpacing="5">
                    <!-- 子孫に変更がある場合の ▼ -->
                    <TextBlock Grid.Column="0"
                               Text="▼"
                               Foreground="{Binding DescendantIndicatorBrush}"
                               IsVisible="{Binding HasDescendantChange}"
                               FontSize="9"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />

                    <!-- 自身の変更マーカー -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding ChangeMarker}"
                               Foreground="{Binding ChangeBrush}"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />

                    <!-- 既存のアイコン -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding Icon}"
                               Foreground="#9CA3AF"
                               FontSize="10"
                               VerticalAlignment="Center" />

                    <!-- GameObject名 -->
                    <TextBlock Grid.Column="3"
                               Text="{Binding Name}"
                               Foreground="#E5E7EB"
                               FontSize="12"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </TreeDataTemplate>
            </TreeView.DataTemplates>
          </TreeView>

          <GridSplitter Grid.Row="2" />

          <Grid Grid.Row="3"
                RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Classes="section-header">
              <TextBlock Text="INSPECTOR"
                         FontSize="11"
                         FontWeight="Bold"
                         Foreground="#A5A9B4" />
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding SelectedTheirsNode.Components}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#363941"
                            BorderThickness="0,0,0,1"
                            Padding="10,8">
                      <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Change}"
                                     MinWidth="14"
                                     FontWeight="Bold" />
                          <TextBlock Text="{Binding Icon}"
                                     Foreground="#9CA3AF" />
                          <TextBlock Text="{Binding TypeName}"
                                     FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding RawText}"
                                   FontSize="10"
                                   Foreground="#9CA3AF"
                                   TextWrapping="Wrap"
                                   MaxHeight="100" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="3"
            Classes="panel"
            Padding="10,8">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Grid.Column="0"
                   Text="STATUS"
                   FontSize="10"
                   FontWeight="Bold"
                   Foreground="#9CA3AF"
                   Margin="0,0,12,0"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding StatusMessage}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

  </Grid>
</Window>
